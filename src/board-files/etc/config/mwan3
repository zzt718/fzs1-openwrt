# ============================================================
# mwan3 双模组分流配置 —— 蜂助手 S1 (MIBOX-668M2)
# 参考社区固件（22.03 版）的实测配置
#
# 【为什么 interval=20 而不是默认 60】
#   mwan3track 评分初值 = down + up = 4，判 online 条件是 score > up(=2)
#   ⇒ 接口一 ifup 就先被当成 online；之后要连续失败 (down+1)=3 次才转 offline
#   ⇒ 窗口期 = interval × (down + 1) = 60×3 = 180 秒
#   这期间 balanced 会 50/50 分流，打到"没有 PDP 的口"的流量全丢
#   （现象：ping/DNS 通但网页打不开）
#   改成 20 后窗口期降到 ~46 秒，代价是探测流量 0.4 → 1.2 MB/天
# ============================================================

config globals 'globals'
	option mmx_mask '0x3F00'

# ---- 模组1（EC200T 主模组，RNDIS）----
config interface 'modem1'
	option enabled '1'
	option family 'ipv4'
	list track_ip '223.5.5.5'
	list track_ip '119.29.29.29'
	option reliability '1'
	option count '1'
	option timeout '4'
	option interval '20'
	option down '2'
	option up '2'

# ---- 模组2（EC200N 云卡模组，RNDIS）----
config interface 'modem2'
	option enabled '1'
	option family 'ipv4'
	list track_ip '223.5.5.5'
	list track_ip '119.29.29.29'
	option reliability '1'
	option count '1'
	option timeout '4'
	option interval '20'
	option down '2'
	option up '2'

# ---- 成员 ----
config member 'modem1_m1'
	option interface 'modem1'
	option metric '1'
	option weight '1'

config member 'modem2_m1'
	option interface 'modem2'
	option metric '1'
	option weight '1'

# ---- 策略：负载均衡 ----
config policy 'balanced'
	list use_member 'modem1_m1'
	list use_member 'modem2_m1'

# ---- 默认规则：全部流量走均衡 ----
config rule 'default_rule'
	option dest_ip '0.0.0.0/0'
	option proto 'all'
	option use_policy 'balanced'
